rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isShortString(value, max) {
      return value is string && value.size() <= max;
    }

    function isOptionalString(data, field, max) {
      return !data.keys().hasAny([field]) || isShortString(data[field], max);
    }

    function isColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function isOptionalColor(data, field) {
      return !data.keys().hasAny([field]) || isColor(data[field]);
    }

    function isDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isOptionalDate(data, field) {
      return !data.keys().hasAny([field]) || isDate(data[field]);
    }

    function isOptionalNumberInRange(data, field, min, max) {
      return !data.keys().hasAny([field])
        || (data[field] is number && data[field] >= min && data[field] <= max);
    }

    function isOptionalTimestamp(data, field) {
      return !data.keys().hasAny([field]) || data[field] is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasOnly([
        'id',
        'name',
        'color',
        'dailyGoal',
        'weeklyGoal',
        'totalTimeSpent',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && isShortString(data.name, 60)
      && isOptionalColor(data, 'color')
      && isOptionalNumberInRange(data, 'dailyGoal', 0, 24)
      && isOptionalNumberInRange(data, 'weeklyGoal', 0, 168)
      && isOptionalNumberInRange(data, 'totalTimeSpent', 0, 1000000)
      && isOptionalTimestamp(data, 'createdAt');
    }

    function isValidSession(data, userId) {
      return data.keys().hasOnly([
        'id',
        'subjectId',
        'subjectName',
        'subjectColor',
        'duration',
        'durationSeconds',
        'focusRating',
        'notes',
        'date',
        'userId',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && (data.subjectId is number || data.subjectId is string)
      && isShortString(data.subjectName, 60)
      && isOptionalColor(data, 'subjectColor')
      && isOptionalNumberInRange(data, 'duration', 1, 1440)
      && isOptionalNumberInRange(data, 'durationSeconds', 1, 86400)
      && isOptionalNumberInRange(data, 'focusRating', 1, 5)
      && isOptionalString(data, 'notes', 500)
      && isOptionalDate(data, 'date')
      && isOptionalTimestamp(data, 'createdAt')
      && data.userId == userId;
    }

    function isValidTodo(data) {
      return data.keys().hasOnly([
        'id',
        'text',
        'date',
        'done',
        'subjectId',
        'subjectName',
        'subjectColor',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && isShortString(data.text, 200)
      && isOptionalDate(data, 'date')
      && data.done is bool
      && (!data.keys().hasAny(['subjectId'])
          || data.subjectId == null
          || data.subjectId is string)
      && (!data.keys().hasAny(['subjectName'])
          || data.subjectName == null
          || isShortString(data.subjectName, 60))
      && (!data.keys().hasAny(['subjectColor'])
          || data.subjectColor == null
          || isColor(data.subjectColor))
      && isOptionalTimestamp(data, 'createdAt');
    }

    function isNullableDate(data, field) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || isDate(data[field]);
    }

    function isNullableNumberInRange(data, field, min, max) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || (data[field] is number && data[field] >= min && data[field] <= max);
    }

    function isValidPlanEntry(data) {
      return data.keys().hasOnly([
        'id',
        'subjectId',
        'hours',
        'scope',
        'day',
        'date',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && data.subjectId is string
      && data.hours is number
      && data.hours >= 0
      && data.hours <= 24
      && (data.scope == 'weekly' || data.scope == 'once')
      && isNullableNumberInRange(data, 'day', 0, 6)
      && isNullableDate(data, 'date')
      && (
        (data.scope == 'weekly' && data.day is number)
        || (data.scope == 'once' && data.date is string)
      )
      && isOptionalTimestamp(data, 'createdAt');
    }

    function isValidBreak(data, userId) {
      return data.keys().hasOnly([
        'id',
        'date',
        'durationSeconds',
        'duration',
        'type',
        'note',
        'userId',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && isOptionalDate(data, 'date')
      && data.durationSeconds is number
      && data.durationSeconds >= 1
      && data.durationSeconds <= 14400
      && data.duration is number
      && data.duration >= 1
      && data.duration <= 240
      && (data.type == 'short' || data.type == 'long' || data.type == 'custom')
      && isOptionalString(data, 'note', 200)
      && data.userId == userId
      && isOptionalTimestamp(data, 'createdAt');
    }

    function isValidHabit(data) {
      return data.keys().hasOnly([
        'id',
        'subjectId',
        'subjectName',
        'subjectColor',
        'name',
        'priority',
        'days',
        'active',
        'startDate',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && data.subjectId is string
      && isShortString(data.subjectName, 60)
      && isColor(data.subjectColor)
      && isShortString(data.name, 80)
      && (data.priority == 'low'
          || data.priority == 'normal'
          || data.priority == 'high'
          || data.priority == 'critical')
      && data.days is list
      && data.days.size() <= 7
      && data.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
      && data.active is bool
      && isOptionalDate(data, 'startDate')
      && isOptionalTimestamp(data, 'createdAt');
    }

    function isValidHabitLog(data) {
      return data.keys().hasOnly([
        'id',
        'habitId',
        'date',
        'done',
        'createdAt'
      ])
      && (data.id is number || data.id is string)
      && data.habitId is string
      && isOptionalDate(data, 'date')
      && data.done is bool
      && isOptionalTimestamp(data, 'createdAt');
    }

    match /studyflow_v1/{userId} {
      allow read, write: if isOwner(userId);

      match /subjects/{subjectId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidSubject(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidSession(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /todos/{todoId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidTodo(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /planEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidPlanEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /breaks/{breakId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidBreak(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /habits/{habitId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidHabit(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /habitLogs/{logId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidHabitLog(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
